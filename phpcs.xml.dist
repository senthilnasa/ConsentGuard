<?xml version="1.0"?>
<ruleset name="Privacy Consent Manager">
    <description>WordPress coding standards for ConsentGuard.</description>

    <!-- Only the shippable plugin folder is linted; tooling lives at the
         repo root so the plugin directory itself stays distribution-clean. -->
    <file>consentguard</file>

    <arg value="ps"/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>

    <rule ref="WordPress">
        <!-- Short array syntax and short ternaries are fine for this project. -->
        <exclude name="Universal.Operators.DisallowShortTernary"/>
        <!-- pcm/PCM is this plugin's established, released prefix (namespace
             PCM\, pcm_* functions/hooks/options, wp_pcm_consents table). -->
        <exclude name="WordPress.NamingConventions.PrefixAllGlobals.ShortPrefixPassed"/>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="consentguard"/>
            </property>
        </properties>
    </rule>

    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="pcm"/>
                <element value="PCM"/>
            </property>
        </properties>
    </rule>

    <rule ref="WordPress.Files.FileName">
        <!-- public/class-public.php intentionally hosts PCM\Frontend:
             "public" is a PHP reserved word, the spec'd file layout keeps
             the frontend class in public/. The autoloader maps it. -->
        <exclude-pattern>public/class-public\.php</exclude-pattern>
    </rule>

    <rule ref="PHPCompatibilityWP"/>
    <config name="testVersion" value="7.4-"/>
    <config name="minimum_wp_version" value="6.2"/>
</ruleset>
