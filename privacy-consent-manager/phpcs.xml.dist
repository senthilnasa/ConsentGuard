<?xml version="1.0"?>
<ruleset name="Privacy Consent Manager">
    <description>WordPress coding standards for Privacy &amp; Consent Manager.</description>

    <file>.</file>
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>node_modules/*</exclude-pattern>
    <exclude-pattern>tests/*</exclude-pattern>

    <arg value="ps"/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>

    <rule ref="WordPress">
        <!-- Short array syntax and short ternaries are fine for this project. -->
        <exclude name="Universal.Operators.DisallowShortTernary"/>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="privacy-consent-manager"/>
            </property>
        </properties>
    </rule>

    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="pcm"/>
                <element value="PCM"/>
            </property>
        </properties>
    </rule>

    <rule ref="PHPCompatibilityWP"/>
    <config name="testVersion" value="7.4-"/>
    <config name="minimum_wp_version" value="6.2"/>
</ruleset>
